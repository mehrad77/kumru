# Every setting Kumru reads, and where it comes from. Copy the dev block to kumru/.dev.vars for
# `pnpm dev`, `pnpm seed` and the Worker tests' local run (wrangler dev reads .dev.vars; it is git-ignored).
# Nothing secret goes in the repo: production secrets are set with `pnpm exec wrangler secret put <NAME>`.

# ---- local dev (.dev.vars) ----------------------------------------------------------------------
# "1" turns on POST /api/dev/login (?as=<username>), skips the IP rate limits, and is never set in production.
DEV=1
# Mixed into every password hash and recovery code. Any string here; production uses its own and never changes it.
PEPPER=dev-pepper-not-secret
# Local dev skips the Turnstile check: an empty site key here overrides wrangler.jsonc's real one.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional locally; reminders send nothing without both keys. `node scripts/vapid.mjs` makes a pair.
VAPID_PRIVATE=

# ---- production secrets (wrangler secret put) ---------------------------------------------------
# PEPPER             a long random string; changing it invalidates every password and recovery code
# TURNSTILE_SECRET_KEY   the secret of the Turnstile widget for turk.shab.boo
# VAPID_PRIVATE      from `node scripts/vapid.mjs` (optional: streak reminders)

# ---- production public vars (wrangler.jsonc "vars", committed) -----------------------------------
# TURNSTILE_SITE_KEY  the widget's site key (empty disables the check)
# VAPID_PUBLIC        the public half of the VAPID pair
# PBKDF2_ITER         password hash iterations for new passwords (25000: login measured 14 ms at 50000, over the 10 ms free budget)
# MIN_CLIENT          comma-separated page versions the API refuses with 426 (normally empty)

# ---- CI / manual deploys ------------------------------------------------------------------------
# GitHub secret (Settings → Secrets → Actions), or exported when you run `pnpm deploy` by hand.
# Needs Workers Scripts, D1 and R2 edit permission for the account that owns shab.boo.
CLOUDFLARE_API_TOKEN=
