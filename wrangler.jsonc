{
  // The Kumru Worker (docs/SPECS.md section 3): static assets from ./public (built by `vite build`),
  // plus the routes in worker/ for /api, /f and /c. Separate from Notebook's own Worker.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yakerim",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/f/*", "/c/*", "/@*"]
  },
  "routes": [{ "pattern": "turk.shab.boo", "custom_domain": true }],
  "vars": { "MIN_CLIENT": "", "DEV": "0", "PBKDF2_ITER": "25000", "TURNSTILE_SITE_KEY": "0x4AAAAAAFQFMa1lV0PQbPNg", "YENI_ORIGINS": "https://yeni.shab.boo", "VAPID_PUBLIC": "BNjPLSnfZAAryihzvB20574oPNUDAbCWcATWktmbgaexqa3okmmME_PlYHchDprmI2BY8tZPqwgpD2W-6aopdC4" },
  // Secrets, set with `wrangler secret put` and never in the repo: PEPPER, TURNSTILE_SECRET_KEY and VAPID_PRIVATE.
  "d1_databases": [
    { "binding": "DB", "database_name": "yakerim", "database_id": "8edcf339-4ef4-4c8a-82b3-aefe2044e0bf", "migrations_dir": "worker/migrations" }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "yakerim-backups" }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
