{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "node"
    ]
  },
  "include": [
    "worker/**/*.ts",
    "shared/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "shared/**/*.test.ts"
  ]
}
